# IN PLUS 1-blok konfiguratsiyasi (namuna qiymatlar)
# Rejim: mock | real — hamma adapter shunga qaraydi
INPLUS_REJIM=mock

# Ildiz — bo'sh bo'lsa kod skript joylashuvidan topadi. Demo:
INPLUS_ILDIZ=~/inplus-demo

# Vaqt zonasi — hamma joyda Asia/Tashkent
TZ=Asia/Tashkent

# Shlyuz porti (127.0.0.1 bind)
INPLUS_SHLYUZ_PORT=8471

# --- Telegram (N2) ---
TG_BOT_TOKEN=
TG_ADMIN_ID=111111111
# TG_REAL=1 bo'lsa mock rejimda ham TG real yuboradi (kanal override)
TG_REAL=0

# --- SMS / ЕТС (N1) ---
ETS_TOKEN=
ETS_JONATUVCHI=INPLUS
# mock ЕТС serveri
ETS_MOCK_URL=http://127.0.0.1:8472
ETS_MOCK_REJIM=ok

# --- amoCRM (D1 real) ---
AMO_DOMEN=
AMO_TOKEN=

# --- GetCourse (D1 real) ---
GC_DOMEN=
GC_KALIT=

# --- Google Sheets (D6 real) ---
SHEETS_ID=
SHEETS_SA_FAYL=
