{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "insident",
  "description": "Insident satri (data/insident/<sana>.jsonl) — X2/X1 yozadi",
  "type": "object",
  "additionalProperties": false,
  "required": ["insident_id", "vaqt", "kim", "agent", "kod", "daraja", "xabar"],
  "properties": {
    "insident_id": {"type": "string"},
    "vaqt": {"type": "string", "format": "date-time"},
    "kim": {"type": "string"},
    "agent": {"type": "string"},
    "kod": {"type": "string", "enum": ["HB_ESKI", "HB_XATO", "HB_YOQ", "UZ_KUTILDI", "UZ_HASH", "UZ_SONI", "UZ_YETIM", "KPI_NISBAT", "KPI_YOQ", "KPI_XATO", "SHLYUZ_CHETLAB", "RESTART_MAX", "UTCNOW"]},
    "daraja": {"type": "string", "enum": ["ogoh", "jiddiy", "kritik"]},
    "xabar": {"type": "string"},
    "harakat": {"type": ["string", "null"]},
    "natija": {"type": ["string", "null"]},
    "yopildi": {"type": ["string", "null"]}
  }
}
