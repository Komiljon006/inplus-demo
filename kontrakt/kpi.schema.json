{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kpi",
  "description": "Agent kunlik KPI fayli (data/kpi/<agent>/<sana>.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["versiya", "agent", "sana", "ishlar", "kun"],
  "properties": {
    "versiya": {"type": "string", "pattern": "^\\d+\\.\\d+$"},
    "agent": {"type": "string"},
    "sana": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "ishlar": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["boshlandi", "tugadi", "davomiylik_s", "holat", "xato_soni", "kirdi", "chiqdi", "kpi"],
        "properties": {
          "boshlandi": {"type": "string"},
          "tugadi": {"type": "string"},
          "davomiylik_s": {"type": "number"},
          "holat": {"type": "string", "enum": ["ok", "xato"]},
          "xato_soni": {"type": "integer"},
          "xato_oxirgi": {"type": ["string", "null"]},
          "kirdi": {"type": "object"},
          "chiqdi": {"type": "object"},
          "kpi": {"type": "object"}
        }
      }
    },
    "kun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ishlar_soni", "ok", "xato", "davomiylik_s_jami", "kpi"],
      "properties": {
        "ishlar_soni": {"type": "integer"},
        "ok": {"type": "integer"},
        "xato": {"type": "integer"},
        "davomiylik_s_jami": {"type": "number"},
        "kpi": {"type": "object"}
      }
    }
  }
}
